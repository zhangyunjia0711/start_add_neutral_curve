#!MC 1410
$!READDATASET '"rough_M3_xbeta_five_frequencies.plt"'
  READDATAOPTION = NEW
  RESETSTYLE = YES
  INITIALPLOTTYPE = XYLINE
$!PLOTTYPE = XYLINE
$!DELETELINEMAPS
$!CREATELINEMAP
$!LINEMAP [1]
  NAME = 'rough_f-100kHz'
  ASSIGN{ZONE=1 XAXISVAR=1 YAXISVAR=2}
  LINES{SHOW=YES COLOR=PURPLE LINEPATTERN=SOLID}
  SYMBOLS{SHOW=NO}
$!CREATELINEMAP
$!LINEMAP [2]
  NAME = 'rough_f-50kHz'
  ASSIGN{ZONE=2 XAXISVAR=1 YAXISVAR=2}
  LINES{SHOW=YES COLOR=BLUE LINEPATTERN=SOLID}
  SYMBOLS{SHOW=NO}
$!CREATELINEMAP
$!LINEMAP [3]
  NAME = 'rough_f+0kHz'
  ASSIGN{ZONE=3 XAXISVAR=1 YAXISVAR=2}
  LINES{SHOW=YES COLOR=BLACK LINEPATTERN=SOLID}
  SYMBOLS{SHOW=NO}
$!CREATELINEMAP
$!LINEMAP [4]
  NAME = 'rough_f+50kHz'
  ASSIGN{ZONE=4 XAXISVAR=1 YAXISVAR=2}
  LINES{SHOW=YES COLOR=GREEN LINEPATTERN=SOLID}
  SYMBOLS{SHOW=NO}
$!CREATELINEMAP
$!LINEMAP [5]
  NAME = 'rough_f+100kHz'
  ASSIGN{ZONE=5 XAXISVAR=1 YAXISVAR=2}
  LINES{SHOW=YES COLOR=RED LINEPATTERN=SOLID}
  SYMBOLS{SHOW=NO}
$!ACTIVELINEMAPS = [1,2,3,4,5]
$!VIEW FIT
$!SAVELAYOUT "rough_M3_xbeta_five_frequencies.lay"
