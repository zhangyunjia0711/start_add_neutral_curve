#!MC 1410
$!READDATASET '"M3_xomega_multiple_beta.plt"'
 READDATAOPTION=NEW
 RESETSTYLE=YES
 INITIALPLOTTYPE=XYLINE
$!PLOTTYPE=XYLINE
$!DELETELINEMAPS
$!CREATELINEMAP
$!LINEMAP [1]
 NAME='bluntplate_beta-30_component1'
 ASSIGN{ZONE=1 XAXISVAR=1 YAXISVAR=2}
 LINES{SHOW=YES COLOR=PURPLE LINEPATTERN=SOLID}
 SYMBOLS{SHOW=NO}
$!CREATELINEMAP
$!LINEMAP [2]
 NAME='bluntplate_beta-20_component1'
 ASSIGN{ZONE=2 XAXISVAR=1 YAXISVAR=2}
