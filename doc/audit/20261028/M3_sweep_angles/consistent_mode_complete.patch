diff --git a/src/public/wall_local_coordinates.f90 b/src/public/wall_local_coordinates.f90
index a3714cb..cd7a1c9 100644
--- a/src/public/wall_local_coordinates.f90
+++ b/src/public/wall_local_coordinates.f90
@@ -13,7 +13,7 @@ module mod_wall_local_coordinates
    public :: wall_local_grid, wall_local_flow
    public :: frozen_wall_basis, projected_normal_derivatives
 
