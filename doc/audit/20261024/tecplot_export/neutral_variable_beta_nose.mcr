#!MC 1410
$!READDATASET '"|MACROFILEPATH|/neutral_variable_beta_nose.plt"'
  READDATAOPTION = NEW
  RESETSTYLE = YES
  INITIALPLOTTYPE = XYLINE
$!PLOTTYPE = XYLINE
$!DELETELINEMAPS
$!CREATELINEMAP
$!LINEMAP [1]
  NAME = "Nose_highest_verified_upper"
  ASSIGN{ZONE=1 XAXISVAR=1 YAXISVAR=2}
  LINES{SHOW=YES COLOR=BLACK}
  SYMBOLS{SHOW=NO COLOR=BLACK}
$!CREATELINEMAP
$!LINEMAP [2]
  NAME = "Nose_conjugate_derived_lower"
  ASSIGN{ZONE=2 XAXISVAR=1 YAXISVAR=2}
  LINES{SHOW=NO COLOR=BLACK}
  SYMBOLS{SHOW=YES COLOR=BLACK}
$!ACTIVELINEMAPS = [1-2]
$!VIEW FIT
$!XYLINEAXIS XDETAIL 1 { COORDSCALE = LOG }
