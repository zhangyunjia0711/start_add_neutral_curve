#!MC 1410
$!READDATASET '"|MACROFILEPATH|/neutral_variable_beta_stage.plt"'
  READDATAOPTION = NEW
  RESETSTYLE = YES
  INITIALPLOTTYPE = XYLINE
$!PLOTTYPE = XYLINE
$!DELETELINEMAPS
$!CREATELINEMAP
$!LINEMAP [1]
  NAME = "Highest_verified_positive_upper"
  ASSIGN{ZONE=1 XAXISVAR=1 YAXISVAR=2}
  LINES{SHOW=YES COLOR=BLUE}
  SYMBOLS{SHOW=NO COLOR=BLACK}
$!CREATELINEMAP
$!LINEMAP [2]
  NAME = "High_frequency_lobe_local_lower"
  ASSIGN{ZONE=2 XAXISVAR=1 YAXISVAR=2}
  LINES{SHOW=YES COLOR=RED}
  SYMBOLS{SHOW=NO COLOR=BLACK}
$!CREATELINEMAP
$!LINEMAP [3]
  NAME = "Low_frequency_lobe_local_upper"
  ASSIGN{ZONE=3 XAXISVAR=1 YAXISVAR=2}
  LINES{SHOW=YES COLOR=PURPLE}
  SYMBOLS{SHOW=NO COLOR=BLACK}
$!CREATELINEMAP
$!LINEMAP [4]
  NAME = "Conjugate_derived_lower_candidates"
  ASSIGN{ZONE=4 XAXISVAR=1 YAXISVAR=2}
  LINES{SHOW=NO COLOR=BLACK}
  SYMBOLS{SHOW=YES COLOR=BLACK}
$!CREATELINEMAP
$!LINEMAP [5]
  NAME = "Positive_growth_test_i10_NOT_NEUTRAL"
  ASSIGN{ZONE=5 XAXISVAR=1 YAXISVAR=2}
  LINES{SHOW=NO COLOR=BLACK}
  SYMBOLS{SHOW=YES COLOR=RED}
$!CREATELINEMAP
$!LINEMAP [6]
  NAME = "Other_candidates_M1c_upper_local"
