$!CREATELINEMAP
$!LINEMAP [11]
  NAME = "Other_candidates_M3nearc_upper_local"
  ASSIGN{ZONE=11 XAXISVAR=1 YAXISVAR=2}
  LINES{SHOW=NO COLOR=BLACK}
