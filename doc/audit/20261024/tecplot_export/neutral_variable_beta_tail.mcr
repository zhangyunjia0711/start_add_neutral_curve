#!MC 1410
$!READDATASET '"|MACROFILEPATH|/neutral_variable_beta_tail.plt"'
  READDATAOPTION = NEW
  RESETSTYLE = YES
  INITIALPLOTTYPE = XYLINE
$!PLOTTYPE = XYLINE
$!DELETELINEMAPS
$!CREATELINEMAP
$!LINEMAP [1]
  NAME = "Highest_verified_positive_upper"
  ASSIGN{ZONE=1 XAXISVAR=1 YAXISVAR=2}
  LINES{SHOW=YES COLOR=BLACK}
  SYMBOLS{SHOW=NO COLOR=BLACK}
$!CREATELINEMAP
$!LINEMAP [2]
  NAME = "High_frequency_lobe_local_lower"
  ASSIGN{ZONE=2 XAXISVAR=1 YAXISVAR=2}
  LINES{SHOW=YES COLOR=BLACK}
  SYMBOLS{SHOW=NO COLOR=BLACK}
$!CREATELINEMAP
$!LINEMAP [3]
  NAME = "Low_frequency_lobe_local_upper"
  ASSIGN{ZONE=3 XAXISVAR=1 YAXISVAR=2}
  LINES{SHOW=YES COLOR=BLACK}
  SYMBOLS{SHOW=NO COLOR=BLACK}
$!ACTIVELINEMAPS = [1-3]
$!VIEW FIT
