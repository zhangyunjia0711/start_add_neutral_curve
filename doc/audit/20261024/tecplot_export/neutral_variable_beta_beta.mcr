#!MC 1410
$!READDATASET '"|MACROFILEPATH|/neutral_variable_beta_beta.plt"'
  READDATAOPTION = NEW
  RESETSTYLE = YES
  INITIALPLOTTYPE = XYLINE
$!PLOTTYPE = XYLINE
$!DELETELINEMAPS
$!CREATELINEMAP
$!LINEMAP [1]
  NAME = "Beta_winner_segment_1"
  ASSIGN{ZONE=1 XAXISVAR=1 YAXISVAR=2}
  LINES{SHOW=YES COLOR=BLACK}
  SYMBOLS{SHOW=NO COLOR=BLACK}
$!CREATELINEMAP
$!LINEMAP [2]
  NAME = "Beta_winner_segment_2"
  ASSIGN{ZONE=2 XAXISVAR=1 YAXISVAR=2}
  LINES{SHOW=YES COLOR=BLACK}
  SYMBOLS{SHOW=NO COLOR=BLACK}
$!CREATELINEMAP
$!LINEMAP [3]
  NAME = "Beta_winner_segment_3"
  ASSIGN{ZONE=3 XAXISVAR=1 YAXISVAR=2}
  LINES{SHOW=YES COLOR=BLACK}
  SYMBOLS{SHOW=NO COLOR=BLACK}
$!CREATELINEMAP
$!LINEMAP [4]
  NAME = "Beta_winner_segment_4"
  ASSIGN{ZONE=4 XAXISVAR=1 YAXISVAR=2}
  LINES{SHOW=YES COLOR=BLACK}
  SYMBOLS{SHOW=NO COLOR=BLACK}
$!ACTIVELINEMAPS = [1-4]
$!VIEW FIT
