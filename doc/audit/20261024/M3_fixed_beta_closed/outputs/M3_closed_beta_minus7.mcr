#!MC 1410
$!READDATASET '"M3_closed_beta_minus7.plt"'
  READDATAOPTION = NEW
  RESETSTYLE = YES
  INITIALPLOTTYPE = XYLINE
$!PLOTTYPE = XYLINE
$!DELETELINEMAPS
$!CREATELINEMAP
$!LINEMAP [1]
  NAME = 'M3 beta=-7'
  ASSIGN{ZONE=1 XAXISVAR=1 YAXISVAR=2}
  LINES{SHOW=YES COLOR=BLUE}
  SYMBOLS{SHOW=NO}
$!ACTIVELINEMAPS = [1]
$!VIEW FIT
$!SAVELAYOUT "M3_closed_beta_minus7.lay"
