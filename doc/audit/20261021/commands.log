      character(*),intent(inout) :: value
      if (cfg%has_key('neutral',key)) call cfg%get('neutral',key,value)
    end subroutine
    integer function parameter_id(name) result(id)
      character(*),intent(in) :: name
      select case(trim(name))
      case('alpha'); id=1
      case('beta'); id=2
      case('omega'); id=3
      case('re'); id=4
      case('iloc'); id=5
      case default; id=0
      end select
