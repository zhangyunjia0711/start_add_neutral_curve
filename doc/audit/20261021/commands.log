#include "../include/start.f90"

   PetscErrorCode :: ierr

   !> SLEPC通用求解类
   type, abstract :: slepc_type

      PetscInt :: m !<问题矩阵维度
      Vec, allocatable :: xr(:)   !<特征向量
      PetscScalar, allocatable :: kr(:) !特征值
      Vec :: initialguess(1) !初始猜测向量
      integer, allocatable :: evIndex(:) !<特征值序号
      PetscScalar :: target !< 目标值
      ST :: st
