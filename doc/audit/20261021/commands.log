   366	      write(unit,'(2(es24.15,1x),i0,1x,9(es24.15,1x),2(i0,1x))') sample%point,i, &
   367	        xx(i,yb+1),r,a,b,o,sample%growth,branch_index,sample%status
   368	    end subroutine
   369	    subroutine refine_peak()
   370	      real(real64) :: left,right,c,d,gc,gd,step
   371	      complex(real64) :: ec,ed,peak_seed
   372	      logical :: vc,vd
   373	      integer :: iteration
   374	      step=(inner_hi-inner_lo)/real(opt%scan_samples-1,real64)
   375	      left=max(inner_lo,best%point(2)-step); right=min(inner_hi,best%point(2)+step)
   376	      peak_seed=best%eigen
   377	      do iteration=1,min(24,opt%max_iterations)
   378	        if (right-left<=opt%x_tol) exit
   379	        c=right-(right-left)*.6180339887498949_real64
   380	        d=left+(right-left)*.6180339887498949_real64
   381	        call evaluate([row_value,c],peak_seed,ec,gc,vc)
   382	        call evaluate([row_value,d],peak_seed,ed,gd,vd)
   383	        if (.not.vc .or. .not.vd) exit
   384	        if (gc>gd) then
   385	          right=d; peak_seed=ec
   386	        else
   387	          left=c; peak_seed=ed
   388	        end if
   389	      end do
   390	    end subroutine
