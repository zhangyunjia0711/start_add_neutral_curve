   310	    subroutine evaluate(point,guess,eigen,g,valid)
   311	      real(real64),intent(in) :: point(2)
   312	      complex(real64),intent(in) :: guess
   313	      complex(real64),intent(out) :: eigen
   314	      real(real64),intent(out) :: g
   315	      logical,intent(out) :: valid
   316	      complex(real64) :: o,a,b
   317	      real(real64) :: r
   318	      integer :: i
   319	      type(neutral_sample) :: sample
   320	      call make_state(point,guess,o,a,b,r,i)
   321	      valid=(i>=1 .and. i<=in .and. r>0._real64)
   322	      eigen=cmplx(ieee_value(0._real64,ieee_quiet_nan),0._real64,real64)
   323	      g=ieee_value(0._real64,ieee_quiet_nan)
   324	      if (valid) then
   325	        call install_state(i,r)
   326	        call lst%solve(o,a,b)
   327	        if (lst_mode==LST_TEMPORAL_MODE) then
   328	          eigen=o; g=aimag(o)
   329	        else
   330	          eigen=a; g=-aimag(a)
   331	        end if
   332	        valid=ieee_is_finite(real(eigen,real64)) .and. ieee_is_finite(aimag(eigen)) .and. &
   333	          ieee_is_finite(g) .and. lst_eigen_error()<=eigen_tol
   334	        if (valid) valid=(abs(eigen-guess)<=jump_tol)
   335	      end if
   336	      eval_count=eval_count+1
   337	      sample%point=point; sample%eigen=eigen; sample%growth=g; sample%residual=abs(g)
   338	      sample%status=NC_EVALUATION_FAILED
   339	      if (valid) then
   340	        sample%status=NC_SUCCESS
   341	        if (.not.best_valid) then
   342	          best=sample; best_valid=.true.
   343	        else if (g>best%growth) then
   344	          best=sample
   345	        end if
   346	      else
   347	        failed_count=failed_count+1
   348	      end if
   349	      if (have_outputs) call write_sample(field_unit,sample,0)
   350	    end subroutine
