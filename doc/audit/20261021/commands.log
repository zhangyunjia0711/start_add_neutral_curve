      procedure(Finalize_interface), deferred :: Finalize

   end type slepc_type

   abstract interface

      subroutine create_interface(this, nev, lst_mode)

         import slepc_type
         class(slepc_type), intent(inout) :: this
         PetscInt, intent(in) :: nev
         integer, intent(in) :: lst_mode

