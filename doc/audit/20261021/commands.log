    subroutine refine_peak()
      real(real64) :: left,right,c,d,gc,gd,step
      complex(real64) :: ec,ed,peak_seed
      logical :: vc,vd
      integer :: iteration
      step=(inner_hi-inner_lo)/real(opt%scan_samples-1,real64)
