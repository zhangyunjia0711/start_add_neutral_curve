#!MC 1410
$!READDATASET '"M3_xbeta_f-100kHz_comparison.plt"'
  READDATAOPTION = NEW
  RESETSTYLE = YES
  INITIALPLOTTYPE = XYLINE
$!PLOTTYPE = XYLINE
$!DELETELINEMAPS
$!CREATELINEMAP
$!LINEMAP [1]
  NAME = 'bluntplate_f-100kHz_A_conjugate'
  ASSIGN{ZONE=1 XAXISVAR=1 YAXISVAR=2}
  LINES{SHOW=YES COLOR=BLUE LINEPATTERN=SOLID}
  SYMBOLS{SHOW=NO}
$!CREATELINEMAP
$!LINEMAP [2]
  NAME = 'bluntplate_f-100kHz_B_conjugate'
  ASSIGN{ZONE=2 XAXISVAR=1 YAXISVAR=2}
  LINES{SHOW=YES COLOR=BLUE LINEPATTERN=DASHED}
  SYMBOLS{SHOW=NO}
$!CREATELINEMAP
$!LINEMAP [3]
  NAME = 'rough_f-100kHz_A_conjugate'
  ASSIGN{ZONE=3 XAXISVAR=1 YAXISVAR=2}
  LINES{SHOW=YES COLOR=RED LINEPATTERN=SOLID}
  SYMBOLS{SHOW=NO}
$!CREATELINEMAP
$!LINEMAP [4]
  NAME = 'rough_f-100kHz_B_conjugate'
  ASSIGN{ZONE=4 XAXISVAR=1 YAXISVAR=2}
  LINES{SHOW=YES COLOR=RED LINEPATTERN=DASHED}
  SYMBOLS{SHOW=NO}
$!ACTIVELINEMAPS = [1,2,3,4]
$!VIEW FIT
$!SAVELAYOUT "M3_xbeta_f-100kHz_comparison.lay"
