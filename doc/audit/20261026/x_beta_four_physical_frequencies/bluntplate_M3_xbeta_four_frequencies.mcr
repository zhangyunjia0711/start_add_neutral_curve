#!MC 1410
$!READDATASET '"bluntplate_M3_xbeta_four_frequencies.plt"'
  READDATAOPTION = NEW
  RESETSTYLE = YES
  INITIALPLOTTYPE = XYLINE
$!PLOTTYPE = XYLINE
$!DELETELINEMAPS
$!CREATELINEMAP
$!LINEMAP [1]
  NAME = 'bluntplate_f-100kHz_A_conjugate'
  ASSIGN{ZONE=1 XAXISVAR=1 YAXISVAR=2}
  LINES{SHOW=YES COLOR=BLUE LINEPATTERN=SOLID}
  SYMBOLS{SHOW=NO}
$!CREATELINEMAP
$!LINEMAP [2]
  NAME = 'bluntplate_f-100kHz_B_conjugate'
  ASSIGN{ZONE=2 XAXISVAR=1 YAXISVAR=2}
  LINES{SHOW=YES COLOR=BLUE LINEPATTERN=DASHED}
  SYMBOLS{SHOW=NO}
$!CREATELINEMAP
$!LINEMAP [3]
  NAME = 'bluntplate_f-50kHz_A_conjugate'
  ASSIGN{ZONE=3 XAXISVAR=1 YAXISVAR=2}
  LINES{SHOW=YES COLOR=BLUE LINEPATTERN=SOLID}
  SYMBOLS{SHOW=NO}
$!CREATELINEMAP
$!LINEMAP [4]
  NAME = 'bluntplate_f-50kHz_B_conjugate'
  ASSIGN{ZONE=4 XAXISVAR=1 YAXISVAR=2}
  LINES{SHOW=YES COLOR=BLUE LINEPATTERN=DASHED}
  SYMBOLS{SHOW=NO}
$!CREATELINEMAP
$!LINEMAP [5]
  NAME = 'bluntplate_f+50kHz_A'
  ASSIGN{ZONE=5 XAXISVAR=1 YAXISVAR=2}
  LINES{SHOW=YES COLOR=BLUE LINEPATTERN=SOLID}
  SYMBOLS{SHOW=NO}
$!CREATELINEMAP
$!LINEMAP [6]
  NAME = 'bluntplate_f+50kHz_B'
  ASSIGN{ZONE=6 XAXISVAR=1 YAXISVAR=2}
  LINES{SHOW=YES COLOR=BLUE LINEPATTERN=DASHED}
  SYMBOLS{SHOW=NO}
$!CREATELINEMAP
$!LINEMAP [7]
  NAME = 'bluntplate_f+100kHz_A'
  ASSIGN{ZONE=7 XAXISVAR=1 YAXISVAR=2}
  LINES{SHOW=YES COLOR=BLUE LINEPATTERN=SOLID}
  SYMBOLS{SHOW=NO}
$!CREATELINEMAP
$!LINEMAP [8]
  NAME = 'bluntplate_f+100kHz_B'
  ASSIGN{ZONE=8 XAXISVAR=1 YAXISVAR=2}
  LINES{SHOW=YES COLOR=BLUE LINEPATTERN=DASHED}
  SYMBOLS{SHOW=NO}
$!ACTIVELINEMAPS = [1,2,3,4,5,6,7,8]
$!VIEW FIT
$!SAVELAYOUT "bluntplate_M3_xbeta_four_frequencies.lay"
