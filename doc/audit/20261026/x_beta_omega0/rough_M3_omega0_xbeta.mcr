#!MC 1410
$!READDATASET '"rough_M3_omega0_xbeta.plt"'
  READDATAOPTION = NEW
  RESETSTYLE = YES
  INITIALPLOTTYPE = XYLINE
$!PLOTTYPE = XYLINE
$!DELETELINEMAPS
$!CREATELINEMAP
$!LINEMAP [1]
  NAME = 'rough'
  ASSIGN{ZONE=1 XAXISVAR=1 YAXISVAR=2}
  LINES{SHOW=YES COLOR=RED}
  SYMBOLS{SHOW=NO}
$!ACTIVELINEMAPS = [1]
$!VIEW FIT
$!SAVELAYOUT "rough_M3_omega0_xbeta.lay"
