#!MC 1410
$!READDATASET '"M3_omega0_xbeta_comparison.plt"'
  READDATAOPTION = NEW
  RESETSTYLE = YES
  INITIALPLOTTYPE = XYLINE
$!PLOTTYPE = XYLINE
$!DELETELINEMAPS
$!CREATELINEMAP
$!LINEMAP [1]
  NAME = 'bluntplate'
  ASSIGN{ZONE=1 XAXISVAR=1 YAXISVAR=2}
  LINES{SHOW=YES COLOR=BLUE}
  SYMBOLS{SHOW=NO}
$!CREATELINEMAP
$!LINEMAP [2]
  NAME = 'rough'
  ASSIGN{ZONE=2 XAXISVAR=1 YAXISVAR=2}
  LINES{SHOW=YES COLOR=RED}
  SYMBOLS{SHOW=NO}
$!ACTIVELINEMAPS = [1,2]
$!VIEW FIT
$!SAVELAYOUT "M3_omega0_xbeta_comparison.lay"
